# SPDX-License-Identifier: Apache-2.0
{
  "nika": "approval-standing-consent",
  "model": "mock/echo",
  "inputs": {
    "subject": {
      "type": "string",
      "required": true
    }
  },
  "permits": {
    "tools": [
      "nika:prompt",
      "nika:read",
      "nika:write"
    ],
    "fs": {
      "read": [
        "./data/**"
      ],
      "write": [
        "./out/**"
      ]
    }
  },
  "tasks": {
    "notes": {
      "invoke": {
        "tool": "nika:read",
        "args": {
          "path": "./data/notes.txt"
        }
      }
    },
    "draft": {
      "with": {
        "notes": "${{ tasks.notes.output }}"
      },
      "infer": {
        "prompt": "Translate ${{ inputs.subject }}: ${{ with.notes }}",
        "max_tokens": 256
      }
    },
    "approve": {
      "after": {
        "draft": "success"
      },
      "invoke": {
        "tool": "nika:prompt",
        "args": {
          "message": "Write out/approved.txt?"
        }
      }
    },
    "effect": {
      "with": {
        "approved": "${{ tasks.approve.output }}"
      },
      "when": "${{ with.approved == true }}",
      "invoke": {
        "tool": "nika:write",
        "args": {
          "path": "./out/approved.txt",
          "content": "approved\n"
        }
      }
    }
  },
  "outputs": {
    "summary": "${{ tasks.draft.output }}"
  }
}
