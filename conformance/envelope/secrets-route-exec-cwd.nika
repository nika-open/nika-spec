# Expected: NIKA-SEC-006 at CHECK. A secret that names an exec working directory is refused even under the exec egress rule (spec 01 §egress · routes).
# A directory is never a secret: the engine judges it against the boundary and
# writes it into the trace. The `exec` rule sanctions the command's arguments,
# never the directory the command runs in.
nika: secrets-route-exec-cwd

secrets:
  api_key:
    source: env
    key: FAKE_API_KEY_FOR_TEST
    egress:
      - to: "exec"

permits:
  exec: ["pwd"]

tasks:
  where:
    exec:
      command: ["pwd"]
      cwd: "${{ secrets.api_key }}"
