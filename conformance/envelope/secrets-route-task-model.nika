# Expected: NIKA-SEC-006 at CHECK. A secret that names a task's model is refused even under the infer egress rule (spec 01 §egress · routes).
# A model id is never a secret: the engine writes it into the trace and the
# receipt, and looks its price up by name. The `infer` rule sanctions the
# prompt the provider receives, never the route that picks the provider.
nika: secrets-route-task-model

secrets:
  api_key:
    source: env
    key: FAKE_API_KEY_FOR_TEST
    egress:
      - to: "infer"

permits:
  tools: []

tasks:
  ask:
    infer:
      model: "${{ secrets.api_key }}"
      prompt: "Say hello."
