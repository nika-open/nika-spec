# Expected: NIKA-SEC-006 at CHECK. A secret in an agent's images.save path is refused even under the agent egress rule (spec 01 §egress · routes).
# A path is never a secret: the engine writes the saved file under it, names it
# in the task's record and in the trace. The `agent` rule sanctions the prompt,
# never the place the agent's images land.
nika: secrets-route-agent-images-save

model: mock/echo

secrets:
  api_key:
    source: env
    key: FAKE_API_KEY_FOR_TEST
    egress:
      - to: "agent"

permits:
  fs:
    write: ["./out/**"]

tasks:
  draw:
    agent:
      prompt: "Draw a blue square."
      images:
        save: "./out/security/${{ secrets.api_key }}.png"
