# Expected: NIKA-SEC-006 at CHECK. A secret in a builtin's file path is refused even under the tool's own egress rule (spec 01 §egress · routes).
# A path is never a secret: the engine judges it against the boundary, writes it
# into the trace and names it in the output. The rule for `nika:write`
# sanctions the content it writes, never the path it writes to.
nika: secrets-route-builtin-path

secrets:
  api_key:
    source: env
    key: FAKE_API_KEY_FOR_TEST
    egress:
      - to: "nika:write"

permits:
  tools: ["nika:write"]
  fs:
    write: ["./out/**"]

tasks:
  keep:
    invoke:
      tool: "nika:write"
      args:
        path: "./out/security/${{ secrets.api_key }}.txt"
        content: "kept"
