# Expected: NIKA-SEC-006 at CHECK. A secret that names a media builtin's model is refused even under the tool's own egress rule (spec 01 §egress · routes).
# The model a media generator calls is never a secret: the builtin names it in
# its event, its manifest and the file it saves. The rule for the tool
# sanctions the call's other arguments, never its `args.model`.
nika: secrets-route-media-args-model

secrets:
  api_key:
    source: env
    key: FAKE_API_KEY_FOR_TEST
    egress:
      - to: "nika:tts_generate"

permits:
  tools: ["nika:tts_generate"]
  fs:
    write: ["./out/**"]

tasks:
  speak:
    invoke:
      tool: "nika:tts_generate"
      args:
        provider: mock
        text: "Hello."
        output_dir: "./out/security"
        model: "${{ secrets.api_key }}"
